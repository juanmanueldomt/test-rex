# testRex configuration for docker compose.
# Copy to `.env` in this directory and fill in the values marked REQUIRED.

# ----------------------------------------------------------------------------
# Secrets (REQUIRED)
# ----------------------------------------------------------------------------

# Secret used to sign sessions and encrypt stored credentials. At least 32 characters.
# Changing it signs everyone out, and organization admins must enter their AI provider API
# keys again (they are encrypted with it).
# Generate one with:  openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-string

# Password for the bundled PostgreSQL database roles (testrex_owner, testrex_app).
# Use letters and digits only (it is embedded in connection URLs).
# Generate one with:  openssl rand -hex 16
POSTGRES_PASSWORD=change-me

# ----------------------------------------------------------------------------
# Optional settings (defaults shown)
# ----------------------------------------------------------------------------

# Image version to run (a release like 0.1.0, or "latest").
TESTREX_VERSION=latest

# Container registry the images are pulled from.
TESTREX_REGISTRY=ghcr.io/testrex

# Host port the web UI and API are published on.
TESTREX_PORT=8080

# URL people use to open testRex (used for invitation links, cookies and origin checks).
# Use https:// in production; session cookies are then marked Secure.
PUBLIC_URL=http://localhost:8080

# Let anyone register (true/false). When false, the first person to register becomes the
# instance administrator and everyone else needs an invitation.
ALLOW_SIGNUP=false

# Database name for the bundled PostgreSQL.
POSTGRES_DB=testrex

# Log verbosity: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info

# Apply database migrations automatically when the app starts (true/false).
# Set to false to run them yourself with:  docker compose run --rm app migrate
AUTO_MIGRATE=true

# Email delivery for invitations. Without SMTP_URL, invitation links are shown in the UI
# for you to share.
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM=testRex <testrex@example.com>

# ----------------------------------------------------------------------------
# Attachments (files and images attached to test scenarios)
# ----------------------------------------------------------------------------

# Largest accepted file, in bytes (default 25 MB).
ATTACHMENT_MAX_BYTES=26214400

# Where files are stored: "local" (a directory, by default the "storage" Docker volume) or
# "s3" (an S3-compatible bucket; nothing is then kept on the containers' disks).
STORAGE_DRIVER=local

# Directory used by STORAGE_DRIVER=local. The images mount the "storage" volume here.
# STORAGE_DIR=/data/storage

# Settings for STORAGE_DRIVER=s3. S3_BUCKET is required; leave S3_ENDPOINT empty for AWS.
# For MinIO or another S3-compatible service set S3_ENDPOINT and S3_FORCE_PATH_STYLE=true.
# Leave both keys empty to use the default AWS credential chain (e.g. an IAM role).
# S3_BUCKET=testrex-attachments
# S3_REGION=us-east-1
# S3_ENDPOINT=http://minio:9000
# S3_FORCE_PATH_STYLE=false
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ----------------------------------------------------------------------------
# Advanced: external database
# ----------------------------------------------------------------------------
# To use your own PostgreSQL 16+ instead of the bundled one, remove the "postgres" service
# from docker-compose.yml and create two roles (as deploy/postgres/init-roles.sh does):
#   CREATE ROLE testrex_owner LOGIN PASSWORD '...';   -- owns the database
#   CREATE ROLE testrex_app   LOGIN PASSWORD '...';   -- runtime, must not be superuser
#   CREATE DATABASE testrex OWNER testrex_owner;
# Runtime connection (Row-Level Security applies to this role):
# DATABASE_URL=postgres://testrex_app:password@host:5432/testrex
# Schema owner connection, used for migrations and the job queue:
# DATABASE_MIGRATION_URL=postgres://testrex_owner:password@host:5432/testrex
