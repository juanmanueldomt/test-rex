# syntax=docker/dockerfile:1
# testRex worker image: background jobs, based on the official Playwright image so that
# browsers are available for test runs.
ARG PLAYWRIGHT_VERSION=1.63.0

FROM node:22-slim AS build
WORKDIR /repo
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --filter "@testrex/worker..."
RUN pnpm turbo run build --filter=@testrex/worker

FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble
ARG PLAYWRIGHT_VERSION
ARG APP_VERSION=0.0.0-dev
ARG GIT_COMMIT=unknown
LABEL org.opencontainers.image.title="testrex-worker" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0"
# Playwright CLI matching the preinstalled browsers.
RUN npm install -g playwright@${PLAYWRIGHT_VERSION} && npm cache clean --force
ENV NODE_ENV=production HEALTH_PORT=8081
WORKDIR /app
COPY --from=build /repo/apps/worker/dist ./dist
COPY --from=build /repo/packages/db/migrations ./migrations
USER pwuser
EXPOSE 8081
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.HEALTH_PORT||8081)+'/readyz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
ENTRYPOINT ["node", "/app/dist/main.js"]
