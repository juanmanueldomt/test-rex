# syntax=docker/dockerfile:1
# testRex worker image: background jobs, based on the official Playwright image so that
# browsers are available for test runs.
ARG PLAYWRIGHT_VERSION=1.63.0

FROM node:22-slim AS build
WORKDIR /repo
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --filter "@testrex/worker..."
RUN pnpm turbo run build --filter=@testrex/worker

FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble
ARG PLAYWRIGHT_VERSION
ARG APP_VERSION=0.0.0-dev
ARG GIT_COMMIT=unknown
LABEL org.opencontainers.image.title="testrex-worker" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.licenses="MIT OR Apache-2.0"
ENV NODE_ENV=production HEALTH_PORT=8081 STORAGE_DIR=/data/storage
WORKDIR /app
# The Playwright library (not bundled) matching the preinstalled browsers in /ms-playwright,
# plus its CLI for maintenance.
RUN printf '{"name":"testrex-worker-runtime","private":true,"type":"module"}' > package.json \
  && npm install --omit=dev --no-audit --no-fund playwright-core@${PLAYWRIGHT_VERSION} \
  && npm install -g playwright@${PLAYWRIGHT_VERSION} \
  && npm cache clean --force
COPY --from=build /repo/apps/worker/dist ./dist
COPY --from=build /repo/packages/db/migrations ./migrations
# Attachment storage shared with the app image, where files belong to node (uid/gid 1000).
# pwuser (uid 1001) joins group 1000 so it can remove abandoned uploads.
RUN mkdir -p /data/storage && chown 1000:1000 /data/storage && chmod 2775 /data/storage   && usermod -a -G 1000 pwuser
USER pwuser
EXPOSE 8081
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.HEALTH_PORT||8081)+'/readyz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
ENTRYPOINT ["node", "/app/dist/main.js"]
